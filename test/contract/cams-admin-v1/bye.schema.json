{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/bye.schema.json",
  "title": "cams-admin v1 bye",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "bye"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "reason"
      ]
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "seq",
    "ts",
    "body"
  ]
}
