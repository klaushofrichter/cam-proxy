{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/commands/switch.survey.args.schema.json",
  "title": "switch.survey args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "switch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sw_[A-Za-z0-9]{20}$"
        },
        "model": {
          "type": "string",
          "maxLength": 64
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        },
        "ports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "offSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "id",
        "model",
        "host",
        "ports",
        "offSeconds"
      ]
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string",
            "pattern": "^cam_[0-9A-HJKMNP-TV-Z]{20}$"
          },
          "host": {
            "type": "string",
            "maxLength": 253,
            "minLength": 1
          }
        },
        "required": [
          "camera",
          "host"
        ]
      },
      "maxItems": 16,
      "minItems": 1
    }
  },
  "required": [
    "v",
    "switch",
    "cameras"
  ]
}
