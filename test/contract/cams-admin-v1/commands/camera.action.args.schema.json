{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/commands/camera.action.args.schema.json",
  "title": "camera.action args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "camera": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "maxLength": 32
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "camera": {
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "required": [
    "v",
    "camera",
    "action"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "retention-run"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "camera": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "camera": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input": {
            "type": "object"
          }
        },
        "required": [
          "input"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "const": "inventory"
          }
        }
      }
    }
  ]
}
