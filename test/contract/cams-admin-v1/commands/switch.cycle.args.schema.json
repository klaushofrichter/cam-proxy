{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/commands/switch.cycle.args.schema.json",
  "title": "switch.cycle args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "switch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sw_[A-Za-z0-9]{20}$"
        },
        "model": {
          "type": "string",
          "maxLength": 64
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        },
        "ports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "offSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "id",
        "model",
        "host",
        "ports",
        "offSeconds"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "host": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "force": {
      "type": "boolean"
    },
    "camera": {
      "type": "string",
      "pattern": "^cam_[0-9A-HJKMNP-TV-Z]{20}$"
    }
  },
  "required": [
    "v",
    "switch",
    "port",
    "host",
    "force",
    "camera"
  ]
}
