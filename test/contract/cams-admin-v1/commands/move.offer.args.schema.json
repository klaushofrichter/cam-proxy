      "const": 1
    },
    "moveId": {
      "type": "string",
      "pattern": "^mv_[0-9A-HJKMNP-TV-Z]{20}$"
    },
    "token": {
      "type": "string",
      "maxLength": 256,
      "minLength": 8,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "source": {
      "type": "object",
      "properties": {
        "proxyId": {
          "type": "string",
          "pattern": "^prx_[0-9A-HJKMNP-TV-Z]{20}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https?://"
        },
        "caFingerprints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SHA256:[0-9A-F]{64}$"
          },
          "maxItems": 2
        },
        "tlsServername": {
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        }
      },
      "required": [
        "proxyId",
        "name",
        "url",
        "caFingerprints",
        "tlsServername"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "camsId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "proxyCameraId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:(?![\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Zl}\\p{Zp}])\\P{Cn}){1,64}$"
        },
        "host": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "maxLength": 64
        },
        "user": {
          "type": "string",
          "maxLength": 64
        },
        "onvifPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rtspPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "baichuanPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
