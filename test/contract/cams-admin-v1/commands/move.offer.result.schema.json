{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/commands/move.offer.result.schema.json",
  "title": "move.offer result v1",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "accept": {
          "const": true
        },
        "space": {
          "type": "object",
          "properties": {
            "needed": {
              "type": "integer",
              "minimum": 0
            },
            "available": {
              "type": "integer",
              "minimum": 0
            },
            "fits": {
              "type": "boolean"
            },
            "perKind": {
              "type": "object",
              "properties": {
                "stills": {
                  "type": "integer",
                  "minimum": 0
                },
                "clips": {
                  "type": "integer",
                  "minimum": 0
                },
                "events": {
                  "type": "integer",
                  "minimum": 0
                },
                "checks": {
                  "type": "integer",
                  "minimum": 0
                },
                "archive": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": []
            },
            "retentionProposal": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z][A-Za-z0-9]{0,31}(\\.[a-z0-9][A-Za-z0-9-]{0,31}){0,5}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "maxLength": 512
                      }
                    ]
                  },
                  "maxProperties": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "needed",
            "available",
            "fits",
            "perKind",
            "retentionProposal"
          ]
        },
        "probeBps": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "accept",
        "space",
        "probeBps"
      ]
    },
    {
      "type": "object",
      "properties": {
        "accept": {
          "const": false
        },
        "reason": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "accept",
        "reason"
      ]
    }
  ]
}
