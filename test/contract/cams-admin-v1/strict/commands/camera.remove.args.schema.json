{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/camera.remove.args.schema.json",
  "title": "camera.remove args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "camera": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "content": {
      "type": "string",
      "enum": [
        "keep",
        "delete"
      ]
    },
    "archive": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "camera",
    "content",
    "archive"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "archive": {
        "const": true
      }
    },
    "required": [
      "archive"
    ]
  },
  "then": {
    "properties": {
      "content": {
        "const": "delete"
      }
    }
  }
}
