{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/switch.survey.result.schema.json",
  "title": "switch.survey result v1",
  "type": "object",
  "properties": {
    "sn": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string",
            "pattern": "^cam_[0-9A-HJKMNP-TV-Z]{20}$"
          },
          "found": {
            "type": "boolean"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "poe": {
            "type": "boolean"
          },
          "watts": {
            "type": "number"
          },
          "link": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_reachable",
              "ambiguous",
              "no_traffic"
            ]
          },
          "ratio": {
            "type": "number"
          }
        },
        "required": [
          "camera",
          "found"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    }
  },
  "required": [
    "sn",
    "results"
  ],
  "additionalProperties": false
}
