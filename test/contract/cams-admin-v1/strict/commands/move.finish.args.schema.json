{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/move.finish.args.schema.json",
  "title": "move.finish args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "moveId": {
      "type": "string",
      "pattern": "^mv_[0-9A-HJKMNP-TV-Z]{20}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "source",
        "target"
      ]
    },
    "abandoned": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "moveId",
    "role",
    "abandoned"
  ],
  "additionalProperties": false
}
