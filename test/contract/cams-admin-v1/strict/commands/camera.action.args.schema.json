{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/camera.action.args.schema.json",
  "title": "camera.action args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "camera": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "camera-test",
        "onvif-resubscribe",
        "camera-ftp-test",
        "poe-switch-read",
        "inventory",
        "inventory-cancel",
        "retention-run",
        "restart",
        "camera-reboot",
        "camera-powercycle",
        "camera-ftp-setup",
        "camera-ftp-off",
        "camera-ntp-set",
        "camera-cert-push"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1
        },
        "camera": {
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "camera",
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "retention-run"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "camera": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "camera": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input": {
            "type": "object"
          }
        },
        "required": [
          "input"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "const": "inventory"
          }
        }
      }
    }
  ]
}
