{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/move.answer.args.schema.json",
  "title": "move.answer args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "moveId": {
      "type": "string",
      "pattern": "^mv_[0-9A-HJKMNP-TV-Z]{20}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^rq_[0-9A-HJKMNP-TV-Z]{20}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "proxyId": {
          "type": "string",
          "pattern": "^prx_[0-9A-HJKMNP-TV-Z]{20}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "required": [
        "proxyId",
        "name"
      ],
      "additionalProperties": false
    },
    "accept": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "moves_not_allowed",
        "camera_unreachable",
        "camera_limit",
        "id_taken",
        "busy",
        "incompatible",
        "no_site_ca",
        "ca_does_not_cover_camera",
        "external_cert",
        "other_account",
        "target_offline",
        "not_routed",
        "host_overridden",
        "target_failed",
        "offer_expired",
        "not_registered",
        "internal"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "space": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "integer",
          "minimum": 0
        },
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "fits": {
          "type": "boolean"
        },
        "perKind": {
          "type": "object",
          "properties": {
            "stills": {
              "type": "integer",
              "minimum": 0
            },
            "clips": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "checks": {
              "type": "integer",
              "minimum": 0
            },
            "archive": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "retentionProposal": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9]{0,31}(\\.[a-z0-9][A-Za-z0-9-]{0,31}){0,5}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "maxLength": 512
                  }
                ]
              },
              "maxProperties": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "needed",
        "available",
        "fits",
        "perKind",
        "retentionProposal"
      ],
      "additionalProperties": false
    },
    "estimateS": {
      "type": "integer",
      "minimum": 0
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stills",
          "clips",
          "events",
          "checks",
          "archive",
          "ptz"
        ]
      },
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": [
    "v",
    "moveId",
    "requestId",
    "target",
    "accept"
  ],
  "additionalProperties": false
}
