{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/tokens.apply.args.schema.json",
  "title": "tokens.apply args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{20}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "client",
              "admin"
            ]
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "retireAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "hash",
          "label",
          "retireAt"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    }
  },
  "required": [
    "v",
    "revision",
    "tokens"
  ],
  "additionalProperties": false
}
