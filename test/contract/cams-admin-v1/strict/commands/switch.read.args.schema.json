{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/commands/switch.read.args.schema.json",
  "title": "switch.read args v1",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "switch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sw_[A-Za-z0-9]{20}$"
        },
        "model": {
          "type": "string",
          "enum": [
            "sscpoe-web"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "minLength": 1
        },
        "ports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "offSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "id",
        "model",
        "host",
        "ports",
        "offSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "switch"
  ],
  "additionalProperties": false
}
