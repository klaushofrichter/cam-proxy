{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/error.schema.json",
  "title": "cams-admin v1 error",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "error"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "retryAfterS": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "re": {
      "type": "string",
      "maxLength": 40
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "seq",
    "ts",
    "body"
  ],
  "additionalProperties": false
}
