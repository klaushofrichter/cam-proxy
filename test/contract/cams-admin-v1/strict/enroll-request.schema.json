{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/enroll-request.schema.json",
  "title": "POST /proxy/v1/enroll request",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "code": {
      "type": "string",
      "maxLength": 64
    },
    "publicKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "proof": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "proxy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "cameraIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 64
        }
      },
      "required": [
        "version",
        "cameraIds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "code",
    "publicKey",
    "proof",
    "proxy"
  ],
  "additionalProperties": false
}
