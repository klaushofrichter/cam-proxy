{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cams-admin.skylar.technology/contract/v1/strict/heartbeat.schema.json",
  "title": "cams-admin v1 heartbeat",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "heartbeat"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object"
        },
        "proxy": {
          "type": "object",
          "properties": {
            "startedAt": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "uptimeS": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "configSchema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "tls": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "site": {
                      "type": "string",
                      "maxLength": 63
                    },
                    "caFingerprint": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^SHA256:[0-9A-F]{64}$"
                      },
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "site",
                    "caFingerprint"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "publicUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "commands": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "paused": {
                  "type": "boolean"
                },
                "pauseReason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tokens.apply",
                      "tokens.apply.admin",
                      "config.get",
                      "config.set",
                      "config.unset",
                      "config.rollback",
                      "camera.name.set",
                      "proxy.restart",
                      "move.send",
                      "move.receive",
                      "camera.action:camera-test",
                      "camera.action:onvif-resubscribe",
                      "camera.action:camera-ftp-test",
                      "camera.action:poe-switch-read",
                      "camera.action:inventory",
                      "camera.action:inventory-cancel",
                      "camera.action:retention-run",
                      "camera.action:restart",
                      "camera.action:camera-reboot",
                      "camera.action:camera-powercycle",
                      "camera.action:camera-ftp-setup",
                      "camera.action:camera-ntp-set",
                      "camera.action:camera-cert-push"
                    ]
                  },
                  "maxItems": 32
                },
                "seenWindow": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "enabled",
                "paused",
                "pauseReason",
                "allow",
                "seenWindow"
              ],
              "additionalProperties": false
            },
            "tokens": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "client": {
                  "type": "integer",
                  "minimum": 0
                },
                "admin": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{20}$"
                  },
                  "maxItems": 64
                }
              },
              "required": [
                "revision",
                "client",
                "admin",
                "blocked"
              ],
              "additionalProperties": false
            },
            "configRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "startedAt",
            "uptimeS",
            "configSchema",
            "tls",
            "publicUrl"
          ],
          "additionalProperties": false
        },
        "truncated": {
          "type": "boolean"
        },
        "profile": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "set": {
                  "type": "boolean"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 60,
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cameras": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "storageGB": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "held": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                },
                "ftp": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "passive": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535
                            },
                            "to": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "enabled",
                    "port",
                    "passive"
                  ],
                  "additionalProperties": false
                },
                "storage": {
                  "type": "object",
                  "properties": {
                    "budgetBytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "usedBytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "diskBytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "freeBytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "budgetBytes",
                    "usedBytes",
                    "diskBytes",
                    "freeBytes"
                  ],
                  "additionalProperties": false
                },
                "hardware": {
                  "type": "object",
                  "properties": {
                    "pi": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "cpuCores": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "cpuModel": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "memoryBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "load5": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cpuTempC": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "pi",
                    "cpuCores",
                    "cpuModel",
                    "memoryBytes",
                    "load5",
                    "cpuTempC"
                  ],
                  "additionalProperties": false
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "profile_ftp_ports",
                      "profile_cameras_exceeded"
                    ]
                  },
                  "maxItems": 2,
                  "uniqueItems": true
                },
                "firewall": {
                  "type": "object",
                  "properties": {
                    "tool": {
                      "type": "string",
                      "enum": [
                        "ufw",
                        "nft"
                      ]
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "maxItems": 64
                    }
                  },
                  "required": [
                    "tool",
                    "lines"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "set",
                "name",
                "cameras",
                "storageGB",
                "held",
                "ftp",
                "storage",
                "hardware",
                "warnings",
                "firewall"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "proxy",
        "truncated"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        },
        "required": [
          "truncated"
        ]
      },
      "then": {
        "properties": {
          "summary": {
            "$ref": "health-summary-truncated.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "summary": {
            "$ref": "health-summary.schema.json"
          }
        }
      }
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "seq",
    "ts",
    "body"
  ],
  "additionalProperties": false
}
