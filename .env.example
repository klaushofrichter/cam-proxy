# Secrets only; every other setting is in config.json (see config.example.json).
# scripts/sync-secrets.sh generates the tokens and the FTP password.
# No inline comments after values: the scripts refuse them.
CAMPROXY_TOKENS=
CAMPROXY_ADMIN_TOKEN=
# The password of the proxy's camera user (config.json camera.user).
CAMPROXY_CAMERA_PASSWORD=
# The camera's FTP login to the proxy, when ftp.enabled.
CAMPROXY_FTP_PASSWORD=
# Optional: Google Vision key for external analytics (README, Analytics). Off without it.
# CAMPROXY_GOOGLE_VISION_KEY=
# Optional: read-only access to GET /control/audit (docs/audit-log.md); 32+ characters, different from the other tokens.
# CAMPROXY_AUDIT_TOKEN=
# Optional: the PoE switch's web password, for the camera power-cycle (docs/poe-switch.md; camera.poeSwitch in config.json).
# CAMPROXY_POE_SWITCH_PASSWORD=

# For the cluster sync (a separate file, e.g. .env.cluster: the cluster's
# camera is cam2). scripts/sync-secrets.sh --env-file .env.cluster --only all
KUBE_CONTEXT=
KUBE_NAMESPACE=cam-proxy
KUBE_SECRET=cam-proxy-secrets
GITHUB_REPO=klaushofrichter/cam-proxy
# The kube-setup deploy token, synced as the repo secret KUBE_SETUP_DEPLOY_TOKEN.
GITHUB_KUBE_SETUP_PAT=

# The cam-proxy-runner registration PAT (deploy/cluster/REQUEST.md), used
# once to create the runner-pat Secret. Not synced by sync-secrets.sh.
#CAMPROXY_GITHUB_PAT=
