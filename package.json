{
  "name": "cam-proxy",
  "version": "0.0.0",
  "description": "Gateway for a Reolink camera: one camera connection, stills, events, clips, and a resumable SSE stream",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "lint:types": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "cam-sim": "https://github.com/klaushofrichter/cam-sim/releases/download/v2026.09.27.1/cam-sim-v2026.09.27.1.tgz",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
