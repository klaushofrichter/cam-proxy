{
  "name": "cam-proxy",
  "version": "0.0.0",
  "description": "Gateway for a Reolink camera: one camera connection, stills, events, clips, and a resumable SSE stream",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.mts",
    "start": "node dist/src/cli.js",
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "lint:types": "tsc --noEmit -p tsconfig.check.json",
    "schema": "tsx scripts/gen-schema.ts",
    "build:web": "vite build --config web/vite.config.mts",
    "dev:web": "vite --config web/vite.config.mts",
    "check": "tsc --noEmit -p web/tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "basic-ftp": "^6.2.1",
    "cam-sim": "https://github.com/klaushofrichter/cam-sim/releases/download/v2026.10.02.1/cam-sim-v2026.10.02.1.tgz",
    "supertest": "^7.3.0",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
