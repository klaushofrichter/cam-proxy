{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cam-proxy config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "HTTP port for the API, control API and admin UI"
        },
        "dataDir": {
          "type": "string",
          "pattern": "^.+$",
          "description": "data folder; relative to the config file"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "fatal",
            "error",
            "warn",
            "info",
            "debug",
            "trace",
            "silent"
          ],
          "description": "pino log level"
        },
        "trustProxy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "reverse proxies in front (the cluster ingress: 1); rate limits then count clients by X-Forwarded-For"
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "description": "where people reach this proxy (its admin UI); reported in /api/cameras so clients can link to it"
        }
      }
    },
    "cameras": {
      "type": "array",
      "description": "the cameras of this proxy, in display order (config.json: a list; overrides: by id)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!file$)(?!.*-file$)[a-z0-9][a-z0-9-]{0,31}$",
            "description": "camera id used in paths and the API"
          },
          "name": {
            "type": "string",
            "pattern": "^.{1,64}$",
            "description": "fallback display name until the camera's own name is read (default: the id)"
          },
          "host": {
            "type": "string",
            "pattern": "^[^\\s/]*$",
            "description": "address or name, optional :port"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "https",
              "http"
            ],
            "description": "camera HTTP API protocol"
          },
          "tlsName": {
            "type": "string",
            "pattern": "^[^\\s]+$",
            "description": "verify the camera certificate against this name"
          },
          "webUiUrl": {
            "type": "string",
            "pattern": "^(https?://[^\\s]+|none)$",
            "description": "the camera's own web page, linked from the admin UI; default https://<host>/, none for no link"
          },
          "user": {
            "type": "string",
            "pattern": "^[^\\s:]{1,31}$",
            "description": "the proxy's own camera user"
          },
          "onvifPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "camera ONVIF port"
          },
          "rtspPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "camera RTSP port"
          },
          "baichuanPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "camera Baichuan port (recordings over TCP); the host is the camera's host"
          },
          "statusPollS": {
            "type": "integer",
            "minimum": 5,
            "maximum": 3600,
            "description": "seconds between status checks"
          },
          "poeSwitch": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 48,
                "description": "the port of the host's PoE switch this camera is on, as numbered on the switch"
              }
            }
          },
          "ftp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "type": "string",
                "pattern": "^[^\\s:]{1,31}$",
                "description": "FTP user this camera logs in as"
              },
              "enabled": {
                "type": "boolean",
                "description": "accept clip uploads from this camera"
              },
              "stream": {
                "type": "string",
                "enum": [
                  "main",
                  "sub"
                ],
                "description": "the stream this camera uploads"
              }
            }
          },
          "stills": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "store stills of this camera"
              },
              "stream": {
                "type": "string",
                "enum": [
                  "sub",
                  "main"
                ],
                "description": "camera stream the stills come from"
              },
              "intervalS": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  10,
                  12,
                  15,
                  20,
                  30,
                  60
                ],
                "description": "seconds between stills (divides a minute)"
              }
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sharePercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "this camera's share of the storage budget, percent (all shares together at most 100)"
              }
            }
          },
          "analytics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kinds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "person": {
                    "type": "boolean",
                    "description": "analyse this camera's person events"
                  },
                  "vehicle": {
                    "type": "boolean",
                    "description": "analyse this camera's vehicle events"
                  },
                  "pet": {
                    "type": "boolean",
                    "description": "analyse this camera's pet events"
                  }
                }
              }
            }
          },
          "events": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "poll": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "poll GetMdState/GetAiState while ONVIF is down"
                  }
                }
              }
            }
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "poeSwitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "none",
            "sscpoe-web"
          ],
          "description": "the cameras' PoE switch: none, or sscpoe-web (the STEAMEMO/SSCPOE local web protocol: GPS-208 and kin)"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$",
          "description": "the switch's address or name, optional :port (http)"
        },
        "ports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "description": "the switch's PoE port count (maps a port to its internal index)"
        },
        "offSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60,
          "description": "seconds the PoE stays off in a power-cycle"
        }
      }
    },
    "go2rtc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": {
          "type": "string",
          "pattern": "^.+$",
          "description": "go2rtc binary started by the proxy"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "description": "go2rtc API when it runs as its own container"
        },
        "rtspPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "go2rtc local RTSP port"
        },
        "apiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "go2rtc local API port"
        }
      }
    },
    "stills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "store stills"
        },
        "stream": {
          "type": "string",
          "enum": [
            "sub",
            "main"
          ],
          "description": "camera stream the stills come from"
        },
        "intervalS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            10,
            12,
            15,
            20,
            30,
            60
          ],
          "description": "seconds between stills (divides a minute)"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$",
          "description": "still size, WxH"
        },
        "quality": {
          "type": "integer",
          "minimum": 2,
          "maximum": 31,
          "description": "ffmpeg JPEG quality (q:v); lower is better"
        },
        "maxGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "size cap for stills"
        }
      }
    },
    "previews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tileSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$",
          "description": "preview tile size, WxH"
        },
        "grid": {
          "type": "string",
          "pattern": "^[1-9][0-9]?x[1-9][0-9]?$",
          "description": "sprite grid, CxR; holds one minute of tiles"
        },
        "quality": {
          "type": "integer",
          "minimum": 2,
          "maximum": 31,
          "description": "ffmpeg JPEG quality for tiles"
        },
        "maxGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "size cap for previews"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onvif": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subscribeMin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "ONVIF subscription lifetime, minutes"
            },
            "pullTimeoutS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "ONVIF PullMessages timeout, seconds"
            }
          }
        },
        "poll": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "poll GetMdState/GetAiState while ONVIF is down"
            },
            "intervalS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "polling interval, seconds"
            },
            "afterOnvifDownS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600,
              "description": "start polling after ONVIF is down this long"
            }
          }
        },
        "maxOpenMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "close an event still open after this many minutes"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stillsDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "days of stills"
        },
        "previewsDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "days of preview sprites"
        },
        "clipsDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "days of clips"
        },
        "eventsDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "days of events"
        },
        "auditDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "days of the audit log"
        },
        "streamLogDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "days of the SSE stream log"
        },
        "intervalMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "minutes between storage runs"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 99,
          "description": "size budget, percent of the disk"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "size budget, bytes (instead of maxPercent)"
        },
        "minFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "stop writing below this much free space"
        },
        "keepHours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stills": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760,
              "description": "hours of stills never deleted for the budget"
            },
            "clips": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760,
              "description": "hours of clips never deleted for the budget"
            },
            "previews": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760,
              "description": "hours of previews never deleted for the budget"
            }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "type": "string",
          "pattern": "^.+$",
          "description": "font file for the badge and card text of composed clips; default: the first of DejaVu Sans (Alpine, Debian) or Arial (macOS) that exists"
        },
        "concurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "composed clips encoded at once (2 on a 4-core host, 1 on a Pi)"
        }
      }
    },
    "sse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxClients": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "most SSE clients at once"
        },
        "queuePerClient": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100000,
          "description": "messages queued per SSE client before it is dropped"
        },
        "pingS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "seconds between keep-alive pings"
        }
      }
    },
    "recordings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheMB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1048576,
          "description": "size cap of the recordings cache, MB; least recently used files go first"
        }
      }
    },
    "ftp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "accept clip uploads from the camera"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "FTP control port"
        },
        "passive": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}-[1-9][0-9]{0,4}$",
          "description": "passive port range, A-B"
        },
        "tls": {
          "type": "boolean",
          "description": "require FTPS"
        },
        "stream": {
          "type": "string",
          "enum": [
            "main",
            "sub"
          ],
          "description": "the stream the camera uploads"
        },
        "stalledHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "description": "warn on the Status page when no clip arrived for this many hours while the camera recorded events"
        },
        "maxGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "size cap for clips"
        },
        "publicHost": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.:-]{1,253}$",
          "description": "the address the camera connects to (PASV replies and the camera FTP setup)"
        },
        "certFile": {
          "type": "string",
          "pattern": "^.+$",
          "description": "FTPS certificate (PEM); a self-signed one otherwise"
        },
        "keyFile": {
          "type": "string",
          "pattern": "^.+$",
          "description": "FTPS key (PEM)"
        },
        "user": {
          "type": "string",
          "pattern": "^[^\\s:]{1,31}$",
          "description": "legacy (with camera): the FTP user the camera logs in as; use cameras[].ftp.user"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diskPercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 99,
          "description": "the data volume's used space, percent, from which the health summary flags a problem"
        },
        "tempC": {
          "type": "integer",
          "minimum": 40,
          "maximum": 95,
          "description": "the CPU temperature, °C, from which the health summary flags a problem (on a Raspberry Pi)"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stats": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "read the host figures (CPU temperature, under-voltage, memory, uptime, load): auto on a Raspberry Pi only, on, or off"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "take new clips into the Archive (reading, editing, deleting and its daily cleanup go on when off)"
        },
        "warnPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "the Archive's size, percent of the data volume, above which the Status page and the health summary warn (no limit)"
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "person": {
              "type": "boolean",
              "description": "analyse person events"
            },
            "vehicle": {
              "type": "boolean",
              "description": "analyse vehicle events"
            },
            "pet": {
              "type": "boolean",
              "description": "analyse pet events"
            }
          }
        },
        "googleVision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "send event stills to Google Vision (needs CAMPROXY_GOOGLE_VISION_KEY)"
            },
            "monthlyLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "description": "Google Vision calls per calendar month (camera time); 0 = none"
            },
            "dailyCap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "description": "Google Vision calls per day at most; 0 = no daily cap"
            },
            "checksPerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "still checks (a second picked by hand in cams) per camera day at most, within the monthly limit and the daily cap; 0 = no checks"
            },
            "perCameraDailyCap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "description": "Google Vision calls per camera and day at most (automatic analyses and still checks together); 0 = no per-camera cap"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "camera id used in paths and the API"
        },
        "name": {
          "type": "string",
          "pattern": "^.{1,64}$",
          "description": "fallback display name until the camera's own name is read (the camera stores its name)"
        },
        "host": {
          "type": "string",
          "pattern": "^[^\\s/]*$",
          "description": "address or name, optional :port (required)"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "https",
            "http"
          ],
          "description": "camera HTTP API protocol"
        },
        "tlsName": {
          "type": "string",
          "pattern": "^[^\\s]+$",
          "description": "verify the camera certificate against this name"
        },
        "webUiUrl": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+|none)$",
          "description": "the camera's own web page, linked from the admin UI; default https://<host>/, none for no link"
        },
        "user": {
          "type": "string",
          "pattern": "^[^\\s:]{1,31}$",
          "description": "the proxy's own camera user"
        },
        "onvifPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "camera ONVIF port"
        },
        "rtspPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "camera RTSP port"
        },
        "baichuanPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "camera Baichuan port (recordings over TCP); the host is camera.host's"
        },
        "statusPollS": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600,
          "description": "seconds between status checks"
        },
        "poeSwitch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "none",
                "sscpoe-web"
              ],
              "description": "the camera's PoE switch: none, or sscpoe-web (the STEAMEMO/SSCPOE local web protocol: GPS-208 and kin)"
            },
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$",
              "description": "the switch's address or name, optional :port (http)"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 48,
              "description": "the switch port the camera is on, as numbered on the switch"
            },
            "ports": {
              "type": "integer",
              "minimum": 1,
              "maximum": 48,
              "description": "the switch's PoE port count (maps the port to its internal index)"
            },
            "offSeconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 60,
              "description": "seconds the PoE stays off in a power-cycle"
            }
          }
        }
      },
      "description": "legacy: one camera (read as cameras: [camera]); use cameras"
    }
  }
}
